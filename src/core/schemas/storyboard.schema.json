{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/storyboard.schema.json",
  "title": "Storyboard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "created_at",
    "source",
    "params",
    "hash",
    "shots"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "params": {
      "type": "object",
      "additionalProperties": true
    },
    "hash": {
      "type": "string",
      "minLength": 1
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shot_id",
          "chapter_id",
          "start_sec",
          "dur_sec",
          "visual_desc",
          "camera_desc",
          "motion",
          "mood",
          "narration_ref",
          "dialogue_ref",
          "assets_ref",
          "transition",
          "status"
        ],
        "properties": {
          "shot_id": {
            "type": "string",
            "minLength": 1
          },
          "chapter_id": {
            "type": "string",
            "minLength": 1
          },
          "start_sec": {
            "type": "number",
            "minimum": 0
          },
          "dur_sec": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "visual_desc": {
            "type": "string",
            "minLength": 1
          },
          "camera_desc": {
            "type": "string",
            "minLength": 1
          },
          "motion": {
            "type": "string",
            "minLength": 1
          },
          "mood": {
            "type": "string",
            "minLength": 1
          },
          "narration_ref": {
            "type": "string",
            "minLength": 1
          },
          "dialogue_ref": {
            "type": "string",
            "minLength": 1
          },
          "assets_ref": {
            "type": "string",
            "minLength": 1
          },
          "transition": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
